{
  "name": "clipvault",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "vite build frontend --outDir ../dist --base=./",
    "desktop": "electron .",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.clipvault.app",
    "productName": "ClipVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14",
    "vite": "^8.3.5"
  }
}
